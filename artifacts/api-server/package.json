{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:a1": "esbuild src/lib/calculator.a1.test.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=./src/lib/calculator.a1.db-shim.ts --outfile=dist/calculator.a1.test.mjs && node --test dist/calculator.a1.test.mjs",
    "test:a2": "esbuild src/lib/run-snapshot.a2.test.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=./src/lib/calculator.a1.db-shim.ts --outfile=dist/run-snapshot.a2.test.mjs && node --test dist/run-snapshot.a2.test.mjs",
    "test:a21": "esbuild src/lib/validation-runs.a21.test.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/validation-runs.a21.test.mjs && node --test dist/validation-runs.a21.test.mjs",
    "test:b1": "esbuild src/lib/prepared-inputs.b1.test.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=./src/lib/calculator.a1.db-shim.ts --outfile=dist/prepared-inputs.b1.test.mjs && node --test dist/prepared-inputs.b1.test.mjs",
    "test:b2": "esbuild src/lib/allocation-b2.test.ts --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=./src/lib/calculator.a1.db-shim.ts --outfile=dist/allocation-b2.test.mjs && node --test dist/allocation-b2.test.mjs",
    "test:validation-job-supervisor": "esbuild src/lib/validation-job-supervisor-control.test.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/validation-job-supervisor-control.test.mjs && node --test dist/validation-job-supervisor-control.test.mjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "quadprog": "2.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "yahoo-finance2": "^3.15.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
